# Modo da API: "real" (padrão) ou "mock" (dados simulados, só em modo direto/desenvolvimento).
# Dentro do iframe da plataforma o módulo usa sempre a API real, mesmo com "mock".
VITE_API_MODE=real

# Prefixo da API no navegador. Padrão: "/api", na mesma origem (gateway — Contrato §12.8).
# Não use URL absoluta de outra porta (ex.: http://localhost:8084/api): quebra dentro da casca.
VITE_API_URL=/api

# Só para `npm run dev`: para onde o Vite encaminha /api (gateway da plataforma, Contrato §9.1).
VITE_GATEWAY=http://localhost:8080

# Site key pública do Google reCAPTCHA v2 Checkbox
VITE_RECAPTCHA_SITE_KEY=
